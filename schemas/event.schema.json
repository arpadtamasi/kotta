{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arpadtamasi/kotta/schemas/event.schema.json",
  "title": "Kotta immutable event",
  "type": "object",
  "required": ["id", "entity", "task", "kind", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^E-[0-9a-hjkmnp-tv-z]{26}$" },
    "entity": { "type": "string", "pattern": "^(O-[0-9]+(?:\\.[0-9]+)?|[TFPD]-[0-9]+|[TFPD]-[0-9a-hjkmnp-tv-z]{26})$" },
    "task": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^(T-[0-9]{3,}|O-[0-9]+(?:\\.[0-9]+)?|T-[0-9a-hjkmnp-tv-z]{26})$" }] },
    "kind": { "enum": ["message", "turn-failed", "lifecycle", "approval"] },
    "created_at": { "type": "string", "format": "date-time" },
    "role": { "enum": ["human", "assistant"] },
    "text": { "type": "string", "minLength": 1 },
    "client_event_id": { "type": ["string", "null"] },
    "thread_id": { "type": ["string", "null"] },
    "attempt_of": { "type": ["string", "null"] },
    "state": { "type": "string" },
    "summary": { "type": "string" },
    "approval_id": { "type": "string", "pattern": "^E-[0-9a-hjkmnp-tv-z]{26}$" },
    "phase": { "enum": ["proposed", "approved", "rejected", "cancelled", "applied", "failed"] },
    "action": { "type": "string" },
    "payload": { "type": "object" },
    "source_message": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
