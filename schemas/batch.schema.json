{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arpadtamasi/kotta/schemas/batch.schema.json",
  "title": "Kotta batch frontmatter",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "contracts",
    "execution",
    "authority",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(P-[0-9]{3,}|P-[0-9a-hjkmnp-tv-z]{26})$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "backlog",
        "defined",
        "active",
        "done"
      ]
    },
    "contracts": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(T-[0-9]{3,}|O-[0-9]+(?:\\.[0-9]+)?|T-[0-9a-hjkmnp-tv-z]{26})$"
      }
    },
    "batches": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(P-[0-9]{3,}|P-[0-9a-hjkmnp-tv-z]{26})$"
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "mode",
        "parallelism",
        "stop_on_failure"
      ],
      "properties": {
        "mode": {
          "enum": [
            "sequential",
            "parallel",
            "dependency-aware"
          ]
        },
        "parallelism": {
          "type": "integer",
          "minimum": 1
        },
        "stop_on_failure": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "sequential"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "parallelism": {
                "const": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "create_observations",
        "create_subcontracts",
        "reorder_independent_contracts",
        "change_scope"
      ],
      "properties": {
        "create_observations": {
          "type": "boolean"
        },
        "create_subcontracts": {
          "type": "boolean"
        },
        "reorder_independent_contracts": {
          "type": "boolean"
        },
        "change_scope": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "blocked": {
      "type": "boolean"
    },
    "blocked_reason": {
      "type": "string",
      "minLength": 1
    },
    "coordinator": {
      "type": "object",
      "required": [
        "branch",
        "base_branch",
        "base_commit"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_branch": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "type": "string",
          "minLength": 7
        },
        "worktree": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "cleaned_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/date"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "$ref": "#/$defs/date"
    },
    "updated_at": {
      "$ref": "#/$defs/date"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "additionalProperties": false
}
