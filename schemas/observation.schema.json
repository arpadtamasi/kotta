{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arpadtamasi/kotta/schemas/observation.schema.json",
  "title": "Kotta observation frontmatter",
  "type": "object",
  "required": ["id", "title", "status", "origin", "observation_type", "confidence", "severity", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^(F-[0-9]{3,}|O-[0-9]+|F-[0-9a-hjkmnp-tv-z]{26})$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["new", "resolved"] },
    "origin": { "enum": ["human", "agent"] },
    "observation_type": { "enum": ["bug", "technical-debt", "risk", "improvement", "inconsistency", "duplication", "security", "performance", "other"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "discovered_during": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^((T|P)-[0-9]{3,}|O-[0-9]+(?:\\.[0-9]+)?|(T|P)-[0-9a-hjkmnp-tv-z]{26})$" }] },
    "disposition": { "enum": ["amend-spec", "create-contract", "attach-to-existing-contract", "investigate", "accept-risk", "reject", "merge-duplicate"] },
    "related_contract": { "type": "string", "pattern": "^(T-[0-9]{3,}|O-[0-9]+(?:\\.[0-9]+)?|T-[0-9a-hjkmnp-tv-z]{26})$" },
    "spec": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*-[0-9a-hjkmnp-tv-z]{26}$" } },
    "duplicate_of": { "type": "string", "pattern": "^(F-[0-9]{3,}|O-[0-9]+|F-[0-9a-hjkmnp-tv-z]{26})$" },
    "created_at": { "$ref": "#/$defs/date" },
    "resolved_at": { "$ref": "#/$defs/date" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
      "then": { "required": ["disposition", "resolved_at"] }
    },
    {
      "if": { "properties": { "disposition": { "const": "amend-spec" } }, "required": ["disposition"] },
      "then": { "required": ["spec"] }
    }
  ],
  "$defs": { "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } },
  "additionalProperties": false
}
