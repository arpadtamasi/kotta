{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arpadtamasi/kotta/schemas/contract.schema.json",
  "title": "Kotta contract frontmatter",
  "type": "object",
  "required": ["id", "title", "status", "origin", "types", "profiles", "priority", "risk", "depends_on", "blocks", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^(T-[0-9]{3,}|O-[0-9]+(?:\\.[0-9]+)?|T-[0-9a-hjkmnp-tv-z]{26})$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["backlog", "defined", "active", "review", "done"] },
    "origin": { "enum": ["human", "agent", "observation", "imported"] },
    "source_observation": { "type": "string", "pattern": "^(F-[0-9]{3,}|O-[0-9]+|F-[0-9a-hjkmnp-tv-z]{26})$" },
    "types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "priority": { "enum": ["low", "medium", "high", "critical"] },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "spec": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        ]
      }
    },
    "batch": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^(P-[0-9]{3,}|P-[0-9a-hjkmnp-tv-z]{26})$" }] },
    "depends_on": { "$ref": "#/$defs/contractIds" },
    "blocks": { "$ref": "#/$defs/contractIds" },
    "branch": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "pull_request": { "oneOf": [{ "type": "null" }, { "type": ["string", "integer"], "minLength": 1 }] },
    "assigned_agent": { "type": "string", "minLength": 1 },
    "worktree": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "execution_mode": { "enum": ["fresh", "inherited"] },
    "blocked": { "type": "boolean" },
    "blocked_reason": { "type": "string", "minLength": 1 },
    "resolution": { "enum": ["completed", "cancelled", "duplicate", "obsolete"] },
    "approved_by": { "$ref": "#/$defs/approvedBy" },
    "approved_at": { "$ref": "#/$defs/approvedAt" },
    "approval_basis": { "$ref": "#/$defs/approvalBasis" },
    "created_at": { "$ref": "#/$defs/date" },
    "updated_at": { "$ref": "#/$defs/date" }
  },
  "allOf": [
    {
      "if": { "properties": { "blocked": { "const": true } }, "required": ["blocked"] },
      "then": { "required": ["blocked_reason"] }
    },
    {
      "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
      "then": { "required": ["branch", "assigned_agent", "worktree", "execution_mode"], "properties": { "branch": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] },
      "then": { "required": ["resolution"] }
    }
  ],
  "dependentRequired": {
    "approved_by": ["approved_at", "approval_basis"],
    "approved_at": ["approved_by", "approval_basis"],
    "approval_basis": ["approved_by", "approved_at"]
  },
  "$defs": {
    "contractIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(T-[0-9]{3,}|O-[0-9]+(?:\\.[0-9]+)?|T-[0-9a-hjkmnp-tv-z]{26})$" } },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "approvedBy": { "type": "string", "minLength": 1 },
    "approvedAt": { "type": "string", "format": "date-time" },
    "approvalBasis": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
