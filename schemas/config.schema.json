{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arpadtamasi/kotta/schemas/config.schema.json",
  "title": "Kotta workspace configuration",
  "type": "object",
  "required": ["version", "project", "git", "validation"],
  "properties": {
    "version": { "const": 6 },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "required": ["base_branch", "protected_branches"],
      "properties": {
        "base_branch": { "type": "string", "minLength": 1 },
        "protected_branches": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "narrative": {
      "description": "Whether the project keeps an OpenSpec narrative beside the model: 'none' (default) — the model is the only specification and nothing under openspec/ is written or checked; 'generated' — kotta archive regenerates each touched capability of openspec/specs from the model; 'authored' — people write openspec/specs, and archive only reports where it disagrees with the model. The SHALL/MUST keyword is required only with 'generated' or 'authored'.",
      "enum": ["none", "generated", "authored"]
    },
    "validation": {
      "type": "object",
      "required": ["strict"],
      "properties": { "strict": { "type": "boolean" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
